{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://wrjhdtdlxekackjdsjpf.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "mediglo-harmony",
      "version": "0.1.0",
      "title": "MediGlo Harmony"
    },
    "tools": [
      {
        "name": "search_customers",
        "title": "Search customers",
        "description": "Search clinic customers (CRM) by name or phone and return their contact details and outstanding balance.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Name or phone fragment to search for."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum rows to return (default 10)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_appointments",
        "title": "List appointments",
        "description": "List clinic appointments within a date range, with customer, time, service inquiry and status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Start date (YYYY-MM-DD), inclusive."
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "End date (YYYY-MM-DD), inclusive."
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "description": "Optional status filter, e.g. scheduled or cancelled."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Maximum rows to return (default 50)."
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "revenue_summary",
        "title": "Revenue summary",
        "description": "Summarise live (non-voided) invoice revenue for a date range: invoice count, gross total, paid amount and balance due.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Start date (YYYY-MM-DD), inclusive."
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "End date (YYYY-MM-DD), inclusive."
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "low_stock_items",
        "title": "Low stock items",
        "description": "List inventory items whose current stock is at or below a threshold, so reordering can be planned.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "description": "Stock level at or below which to report (default 5)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Maximum rows to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_follow_up",
        "title": "Create follow-up task",
        "description": "Create a follow-up task in the clinic follow-up desk queue for a patient.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "patient_name": {
              "type": "string",
              "minLength": 1,
              "description": "Patient / customer name."
            },
            "trigger_reason": {
              "type": "string",
              "minLength": 1,
              "description": "Why this follow-up is needed."
            },
            "patient_phone": {
              "type": "string",
              "minLength": 1,
              "description": "Contact phone number."
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "description": "Additional notes for the caller."
            },
            "next_followup_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date the follow-up is due (YYYY-MM-DD)."
            }
          },
          "required": [
            "patient_name",
            "trigger_reason"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
